</head>

<body>

<div class="container">

    <h1>בנק יעדי התפתחות</h1>

    <p class="subtitle">ניהול ידע ומצוינות מקצועית | 1-250</p>

    

    <div class="search-area">

        <input type="text" id="search" class="search-box" placeholder="חיפוש חופשי (שם מטרה, מספר...)" onkeyup="filter()">

        <select id="tagFilter" class="filter-select" onchange="filter()">

            <option value="">-- בחרי קושי/נושא --</option>

