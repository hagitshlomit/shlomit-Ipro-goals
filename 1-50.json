</div>



<div id="myModal" class="modal">

    <div class="modal-content">

        <div id="modalHeader" class="modal-header">

            <span class="close" onclick="closeModal()">&times;</span>

            <h2 id="modalTitle" style="margin:0;"></h2>

        </div>

        <div class="modal-body">

            <div class="card"><span class="card-label">הבעיה</span><div id="modalProb"></div></div>

            <div class="card"><span class="card-label">המטרה</span><div id="modalGoal"></div></div>

            <div id="keywordsCard" class="card" style="display:none; border-right: 5px solid var(--iam);"><span class="card-label">מילות מפתח</span><div id="modalKeywords" style="font-weight:bold; color:var(--iam);"></div></div>

            <div class="card" style="background:#e0f2fe; border-right: 5px solid #0284c7;"><span class="card-label">שיטות עבודה (5 שלבים)</span><ul id="modalMethods" class="methods-list" style="padding-right:20px;"></ul></div>

        </div>

    </div>

</div>



<script>

    let allGoals = [];

    const files = ['1-50.json', '51-100.json', '101-150.json', '151-200.json', '201-250.json'];



    async function loadData() {

        for (let f of files) {

            try {

                const r = await fetch(f + '?v=' + Date.now());

                if (r.ok) {

                    const data = await r.json();

                    data.forEach(g => { if(!allGoals.find(x => x.id === g.id)) allGoals.push(g); });

                }

            } catch (e) { console.error("Error loading file " + f, e); }

        }

        render();

    }



    function render() {

        const containers = { 'I AM': document.getElementById('I AM'), 'I MIX': document.getElementById('I MIX'), 'I TASK': document.getElementById('I TASK'), 'I NET': document.getElementById('I NET'), 'I GROW': document.getElementById('I GROW') };

        Object.values(containers).forEach(c => c.innerHTML = '');

        allGoals.sort((a,b) => a.id - b.id).forEach(goal => {

            const li = document.createElement('li');

            li.className = 'item';

            const keys = goal.keywords ? goal.keywords.join(' ') : '';

            li.setAttribute('data-keywords', keys);

            li.innerHTML = `<span class="item-title">#${goal.id} ${goal.title}</span><div class="item-prob">${goal.prob}</div>`;

            li.onclick = () => showDetail(goal);

            const target = containers[goal.cluster.toUpperCase()];

            if(target) target.appendChild(li);

        });

    }



    function showDetail(g) {

        const colors = {'I AM': 'var(--iam)', 'I MIX': 'var(--imix)', 'I TASK': 'var(--itask)', 'I NET': 'var(--inet)', 'I GROW': 'var(--igrow)'};

        document.getElementById('modalHeader').style.backgroundColor = colors[g.cluster.toUpperCase()] || '#333';

        document.getElementById('modalTitle').innerText = g.title;

        document.getElementById('modalProb').innerText = g.prob;

        document.getElementById('modalGoal').innerText = g.goal;

        const kwCard = document.getElementById('keywordsCard');

        if (g.keywords && g.keywords.length > 0) {

            kwCard.style.display = 'block';

            document.getElementById('modalKeywords').innerText = g.keywords.join(', ');

        } else { kwCard.style.display = 'none'; }

        document.getElementById('modalMethods').innerHTML = g.methods.map(m => `<li>${m}</li>`).join('');

        document.getElementById('myModal').style.display = "block";

    }



    function closeModal() { document.getElementById('myModal').style.display = "none"; }



    function filter() {

        const searchVal = document.getElementById('search').value.toLowerCase();

        const tagVal = document.getElementById('tagFilter').value.toLowerCase();

        

        document.querySelectorAll('.item').forEach(el => {

            const content = el.innerText.toLowerCase();

            const keywords = el.getAttribute('data-keywords').toLowerCase();

            

            const matchSearch = content.includes(searchVal) || keywords.includes(searchVal);

            const matchTag = tagVal === "" || keywords.includes(tagVal);

            

            if (matchSearch && matchTag) {

                el.style.display = 'block';

            } else {

                el.style.display = 'none';

            }

        });

    }



    window.onclick = (e) => { if (e.target == document.getElementById('myModal')) closeModal(); }

    loadData();

</script>

</body>

</html>

עכשיו הכל ברור! הקוד ששלחת הוא "מפת האוצר" שחיפשנו. הוא חושף בדיוק למה שום דבר לא עבד ולמה האשכולות נעלמו.

הנה הדיאגנוזה (מה שבור):
שמות הקבצים: הקוד שלך מחפש קבצים בשמות ספציפיים מאוד (שורה 133):
'1-50.json', '51-100.json', '101-150.json', '151-200.json', '201-250.json'
אם הקובץ בגיטהאב נקרא cluster2.json, האתר פשוט מתעלם ממנו.

שם האשכול (Cluster Name): זו הבעיה הכי גדולה! הקוד מצפה לשמות באנגלית ובאותיות גדולות (שורה 144):
I AM, I MIX, I TASK, I NET, I GROW.
כשאנחנו כתבנו בקובץ "cluster": "כישורי חיים" או "I DO", האתר לא ידע לאיזה עמודה לשייך אותם, ולכן הם לא הופיעו.

איך מתקנים את זה עכשיו ב-5 דקות?
אנחנו הולכים ליצור את הקובץ 51-100.json מחדש, אבל הפעם עם הנתונים המדויקים שהקוד שלך דורש.

השלבים בגיטהאב:

צרי קובץ חדש (או ערכי את הקיים) בשם: 51-100.json (שימי לב: בלי רווחים, באותיות קטנות).

הדביקי פנימה את הטקסט הזה (שימי לב ששיניתי את ה-cluster ל-I MIX, שזו העמודה השנייה באתר שלך):

