        "תיעוד ביומן הצלחות של התחושה הפנימית לאחר שבוצעה פנייה חברתית מוצלחת בבוקר.",
        "למידת שמותיהם ותפקידיהם של 5 אנשים חדשים בארגון בתוך חודש עבודה אחד.",
        "יצירת \"מפת שמות\" ויזואלית של המחלקה הכוללת שמות, תפקידים ותמונה (במידת האפשר).",
        "שימוש מכוון בשם האדם במהלך כל פנייה אליו (למשל: \"היי דנה, תוכלי לעזור לי?\").",
        "רפלקציה: \"איך השימוש בשם של הקולגה היום השפיע על הטון של השיחה בינינו?\".",
        "וידוא שם האדם בשיחת היכרות קצרה ושינון השם בעזרת כרטיסי זיכרון דיגיטליים (Anki).",
        "הצעת רעיון אחד לפעילות משותפת קטנה (כמו הזמנת פיצה או משחק בהפסקה) פעם בחודש.",
        "לקיחת אחריות על ארגון פרט טכני אחד (כמו איסוף כסף או הזמנת מקום) בפעילות קבוצתית.",
        "ייזום שיחה בנושא תחביב משותף עם חבר אחד במהלך ההפסקה למשך 5 דקות.",
        "רפלקציה: \"איך הרגשתי כשהובלתי יוזמה חברתית? האם אנשים שיתפו פעולה?\".",
        "קבלת חיזוק מהרכזת על היוזמה והמנהיגות החברתית שהופגנה בשטח.",
        "שימוש בכרטיסיות צבעים (ירוק-פנוי, אדום-צריך שקט) לביטוי מצב חברתי בעמדת העבודה.",
        "תרגול משפטי \"הסבר צורך\" בסימולציה: \"קצת רועש לי כאן עכשיו, אשמח אם נוכל להנמיך\".",
        "כתיבת הצרכים החברתיים האישיים במכתב לעצמו לצורך הגדרת הגבולות בצורה ברורה.",
        "רפלקציה: \"האם הצלחתי היום להסביר מה אני צריך חברתית מבלי לפגוע באחרים?\".",
        "קיום שיחת רפלקציה שבועית עם הרכזת על חוויות חברתיות מאתגרות ודרכי התמודדות.",
        "שימוש בלוח משימות (כגון Planner) לחלוקה ברורה ומתועדת של סמכויות בין חברי הצוות.",
        "ביצוע סימולציה של \"חילופי תפקידים\" עם עמית כדי להבין את הקושי והצרכים של הצד השני.",
        "קבלת תפקיד \"משני\" במשימה אחת במודע, לצורך תרגול הקשבה והובלה של מישהו אחר.",
        "רפלקציה: \"מה למדתי מהשותף שלי למשימה היום על סגנון עבודה שונה משלי?\".",
        "מתן 2 מחמאות כנות לשותף למשימה על חלקו הספציפי בביצוע המוצלח.",
        "שימוש בטכניקת \"הקשבה פעילה\" (הנהון, קשר עין, כתיבת דברי האחר) לאורך כל הישיבה.",
        "המללת דעת החבר (\"אם הבנתי נכון, אתה אומר ש...\") לפני הבעת דעה מנוגדת אישית.",
        "כתיבת נקודה אחת מעניינת או חשובה שנאמרה על ידי מישהו אחר במהלך הדיון.",
        "רפלקציה: \"האם הצלחתי היום להקשיב עד הסוף מבלי להתפרץ? איך זה השפיע על השיחה?\".",
        "קיום שיחה קצרה לאחר הישיבה עם אדם שדעתו הייתה שונה, להעמקת ההבנה.",
        "תצפית מכוונת על אינטראקציות חברתיות בקבוצה ורישומן ביומן למידה לזיהוי דפוסים.",
        "שיחה עם הרכזת להבנת התפקידים הבלתי פורמליים בקבוצה (מי הדמויות המשפיעות).",
        "זיהוי \"דמות מפתח\" חברתית ופנייה אליה בבקשת עצה בנושא חברתי פשוט.",
        "רפלקציה: \"מי היום היה הדמות שהובילה את השיחה בקבוצה? איך פניתי אליה?\".",
        "קבלת משוב מהרכזת על מידת הרגישות וההתאמה החברתית שהופגנה במפגש הקבוצתי.",
        "שיתוף פרט אישי אחד פשוט (תחביב/סרט שראיתי) עם עמית אחד לפחות פעם ביומיים.",
        "הצגת \"חפץ משמעותי\" במפגש קבוצתי והסבר קצר על הקשר האישי אליו.",
        "הצטרפות לקבוצת עניין (כגון חובבי גיימינג או בישול) בתוך מסגרת השירות לחיזוק השיתוף.",
        "רפלקציה: \"איך הרגשתי כשסיפרתי משהו אישי על עצמי? האם זה קירב ביני לבין האחר?\".",
        "תיעוד ביומן: \"מה גיליתי היום על מישהו אחר בזכות זה שפתחתי בשיחה אישית?\".",
        "תרגול מול מראה או עם הרכזת של הפניית הראש והגוף לעבר מקור הקול של הדובר.",
        "שימוש במחוות אישור קוליות (למשל: \"כן\", \"נכון\", \"מבין\") במקום הנהון שאינו נראה.",
        "בקשה אקטיבית מהקולגות למתן סימנים קוליים ברורים לכך שהם מקשיבים ומגיבים.",
        "רפלקציה: \"האם הרגשתי היום שהקשיבו לי בזכות זה שהופניתי אל הצד השני?\".",
        "תיעוד ביומן הצלחות של שיחה שבה המתנדב הרגיש מסונכרן עם שפת הגוף של האחר.",
        "הצטרפות לשיחה קבוצתית קטנה (עד 3 אנשים) המקלה על קריאת שפתיים ושימוש בתמלול.",
        "שימוש במיקרופון מרוחק (FM) בישיבות צוות וקישורו למכשיר השמיעה/שתל.",
        "בקשה אקטיבית מהחברים בשיחה לדבר אחד-אחד ולא בו-זמנית לצורך הבנה מלאה.",
        "רפלקציה: \"באילו רגעים בשיחה היום הרגשתי הכי שייך ומעורב? מה עזר לי?\".",
        "שימוש בווידאו-צ'אט עם תמלול לשמירה על קשר חברתי מחוץ לשעות השירות.",
        "פנייה ישירה לאדם שנוצרה מולו אי-הבנה בתוך 48 שעות לצורך בירור ענייני ומכבד.",
        "שימוש במשפטי בירור בסימולציה: \"שמתי לב ש... האם הבנתי נכון את מה שאמרת?\".",
        "כתיבת סיכום הסיטואציה לעצמו כדי להבין את נקודת המבט שלו ושל האחר לפני הפנייה.",
        "רפלקציה: \"איך הרגשתי לאחר שביררתי את הדברים? האם המתח ירד?\".",
        "תרגול התנצלות כנה במידה והמתנדב זיהה שנעשתה טעות חברתית מצידו.",
        "שימוש ב\"חפץ דיבור\" או סימן מוסכם עם הרכזת לפני לקיחת רשות דיבור בישיבה.",
        "ספירה עד 3 בלב לאחר שהצד השני סיים לדבר ורק אז התחלת תגובה אישית.",
        "שימוש בטיימר ויזואלי להגדרת משך התגובה בשיחה (למשל: עד 2 דקות רצופות).",
        "רפלקציה: \"כמה פעמים היום עצרתי את עצמי מלהתפרץ? איך זה השפיע על השיחה?\".",
        "תרגול סימולציה של \"הקשבה שקטה\" למשך 2 דקות ברצף מבלי להוסיף מילה.",
        "שליחת הודעת וואטסאפ של \"יום טוב\" או \"בהצלחה\" לחבר לקבוצה פעם בשבוע.",
